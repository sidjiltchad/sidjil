{
  "description": "سِجِل — SIDJIL: منصة رقمية لحفظ وفهرسة مصادر تاريخ تشاد",
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.9.2",
    "wrangler": "^3.114.17"
  },
  "name": "sidjil",
  "private": true,
  "scripts": {
    "admin:hash": "node scripts/hash-password.js",
    "db:export": "node scripts/export-d1.mjs",
    "db:migrate:local": "wrangler d1 migrations apply SIDJIL --local",
    "db:migrate:remote": "wrangler d1 migrations apply SIDJIL --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run mobile:build && npx cap sync android",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:open": "npx cap open android",
    "android:debug": "npm run mobile:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 assembleDebug",
    "android:release": "npm run mobile:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 assembleRelease",
    "android:bundle": "npm run mobile:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 bundleRelease",
    "test": "node scripts/ci-contract.mjs",
    "test:bilingual": "node scripts/bilingual-search-check.mjs",
    "test:mobile": "node scripts/mobile-phase1-check.mjs",
    "test:mobile:auth": "node scripts/mobile-phase2-check.mjs",
    "test:mobile:feed": "node scripts/mobile-phase3-check.mjs",
    "test:mobile:search-profile": "node scripts/mobile-phase4-search-profile-check.mjs",
    "test:mobile:pdf": "node scripts/mobile-phase5-pdf-check.mjs",
    "test:mobile:files": "node scripts/mobile-phase6-files-check.mjs",
    "test:mobile:word-upload": "node scripts/mobile-phase7-word-upload-check.mjs",
    "test:mobile:android": "node scripts/mobile-phase8-android-check.mjs",
    "test:mobile:social": "node scripts/mobile-social-check.mjs",
    "test:mobile:release": "node scripts/mobile-phase9-release-check.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs"
  },
  "version": "0.1.0",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "pdf-lib": "^1.17.1"
  }
}
